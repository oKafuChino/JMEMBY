FROM python:3.12-slim
ARG APP_UID=1000
ARG APP_GID=1000
RUN groupadd --gid ${APP_GID} agent && useradd --uid ${APP_UID} --gid agent --create-home agent
WORKDIR /app
# The agent installs only its download/transport dependencies, no Bot or Komga service.
RUN pip install --no-cache-dir 'aiohttp>=3.10,<4' 'Pillow>=12,<13' 'jmcomic>=2.5,<3'
COPY src/jmemby/__init__.py ./src/jmemby/__init__.py
COPY src/jmemby/domain ./src/jmemby/domain
COPY src/jmemby/providers ./src/jmemby/providers
COPY src/jmemby/storage ./src/jmemby/storage
COPY src/jmemby/distributed/__init__.py src/jmemby/distributed/config.py src/jmemby/distributed/agent.py ./src/jmemby/distributed/
COPY src/jmemby/runtime.py ./src/jmemby/runtime.py
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN mkdir /agent-data && chown agent:agent /agent-data
USER agent
ENTRYPOINT ["python", "-m", "jmemby.distributed.agent"]
