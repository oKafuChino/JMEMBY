# HTTPS controller origin; use a dedicated domain pointing to the agent API.
AGENT_MASTER_URL=https://agents.example.com
# Every VPS must have its own ID and its own token registered on the controller.
AGENT_ID=vps-1
AGENT_TOKEN=replace-me
# Parallel page-download groups within ONE manga. This VPS always handles one manga at a time.
AGENT_CONCURRENCY=2
AGENT_OPERATION_TIMEOUT=300
AGENT_MAX_PAGE_BYTES=31457280
AGENT_MAX_PIXELS=50000000
AGENT_MIN_FREE_SPACE_MB=512
JM_API_DOMAINS=
