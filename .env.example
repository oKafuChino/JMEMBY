TELEGRAM_BOT_TOKEN=replace-me
# Administrator IDs (legacy setting name); ordinary users register via /register.
TELEGRAM_ALLOWED_USER_IDS=123456789
DATABASE_URL=sqlite+aiosqlite:///./data/app/jmemby.db
STORAGE_ROOT=/storage
KOMGA_BASE_URL=http://komga:25600
KOMGA_PUBLIC_URL=https://komga.example.com
KOMGA_LIBRARY_ID=replace-after-komga-setup
KOMGA_LIBRARY_ROOT=/data
DOWNLOAD_CONCURRENCY=2
RETRY_MAX_ATTEMPTS=3
MIN_FREE_SPACE_GB=5
DISK_SPACE_CHECK_ENABLED=false
RESUME_FREE_SPACE_GB=10
LOG_LEVEL=INFO
# Empty uses the bundled JMComic and Komga adapters; JSON argv overrides are optional.
PROVIDER_COMMAND=
KOMGA_COMMAND=
PROVIDER_DOMAINS=
KOMGA_USERNAME=
KOMGA_PASSWORD=
JM_API_DOMAINS=
KOMGA_IMPORT_TIMEOUT=240
# Defaults to the latest Komga image; optional override.
KOMGA_IMAGE=gotson/komga:latest
APP_UID=1000
APP_GID=1000
OPERATION_TIMEOUT=300
MAX_PAGE_BYTES=31457280
MAX_PIXELS=50000000
MAX_CHAPTER_PAGES=2000
MAX_TASK_BYTES=10737418240
# Admin panel: HTTPS reverse proxy or localhost SSH tunnel.
WEB_ENABLED=false
WEB_PORT=8080
WEB_PUBLIC_URL=http://localhost:8080
# Optional remote whole-manga downloading. See docs/DISTRIBUTED_DOWNLOADS.md.
DISTRIBUTED_ENABLED=false
# Optional legacy seed only; leave {} and create nodes in the admin web panel.
DOWNLOAD_AGENT_TOKENS={}
DISTRIBUTED_PORT=8081
DISTRIBUTED_LEASE_SECONDS=90
DISTRIBUTED_JOB_TIMEOUT=1800
